#!/bin/bash

remove_divert ()
{
	if dpkg-divert --listpackage "$2" | grep -q "$DPKG_MAINTSCRIPT_PACKAGE"; then
		dpkg-divert --remove --package "$DPKG_MAINTSCRIPT_PACKAGE" --rename --divert "$1" "$2"
		EXIT=$?; if [ $EXIT -ne 0 ]; then exit $EXIT; fi
	fi
}

dist_upgrade_migrate ()
{
	SRCSFILES=("/etc/apt/sources.list" "/etc/apt/sources.list.d/*osmc*.list")
	# Update APT sources.list
	for SRCSFILE in ${SRCSFILES[@]}; do
		sed 's/buster\/updates/bullseye-security/g;s/buster/bullseye/g' -i $SRCSFILE
	done
	# Signal we want a dist-upgrade and a reboot
	touch /dist_upgrade_wanted
	osmc-runtime-flag set reboot-needed 2>/dev/null || touch /tmp/reboot-needed
}

if [ -z "$DPKG_MAINTSCRIPT_PACKAGE" ]; then exit 1; fi
if [ "$1" = "triggered" ]; then
	echo "Fixing permissions on busybox."
	chmod +s /bin/busybox 2>/dev/null
fi
if [ "$1" = "configure" ]; then
	echo "Fixing permissions on busybox."
	chmod +s /bin/busybox 2>/dev/null

	# /run is tmpfs, so tmpfiles.d recreates /run/osmc on every boot - but
	# create it now too, so flags set later in this same apt run land there
	# rather than falling back to /tmp.
	systemd-tmpfiles --create /usr/lib/tmpfiles.d/osmc.conf 2>/dev/null || true

	systemctl daemon-reload

	# Periodic TRIM. SD cards and eMMC lose sustained write performance as
	# unused blocks accumulate untrimmed, and until now only Vero got a
	# discard pass (perftune runs fstrim at boot there); Pi never did.
	#
	# util-linux already ships fstrim.timer - weekly, with Persistent=true
	# so it catches up after the box has been off - which covers every
	# platform without adding anything to the boot path. A first TRIM on a
	# long-lived card can take a while and is heavy on I/O, so a boot-time
	# pass would land right on top of Kodi starting up.
	#
	# Guarded because the unit only exists if util-linux provides it, and a
	# failed enable must not fail the package. Deliberately not started
	# here: Persistent=true means a first run would fire during this apt
	# transaction, so it waits for the next boot.
	if [ -f /lib/systemd/system/fstrim.timer ] || \
	   [ -f /usr/lib/systemd/system/fstrim.timer ]; then
		systemctl enable fstrim.timer >/dev/null 2>&1 || true
	fi

	systemctl enable osmc-prune-devel.timer
	systemctl enable osmc-id-generator.service osmc-report-stats.timer
	systemctl start osmc-id-generator.service osmc-report-stats.timer

	# migrate sources.list only if the previous base-files-osmc version is older than this version
	#if [ -n "$2" ] && dpkg --compare-versions "$2" lt "3.1.8"; then
	#dist_upgrade_migrate
	#fi

	# disable persistent journalling if enabled
	if [ -n "$2" ] && dpkg --compare-versions "$2" lt "3.3.4"; then
		journalctl --relinquish-var
		rm -rf /var/log/journal
	fi

fi
exit 0
